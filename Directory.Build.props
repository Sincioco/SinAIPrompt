<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
    <VisualStudioWebViewPath Condition="'$(VisualStudioWebViewPath)' == '' and '$(VSInstallDir)' != ''">$(VSInstallDir)Common7\IDE\PrivateAssemblies</VisualStudioWebViewPath>
    <VisualStudioWebViewPath Condition="'$(VisualStudioWebViewPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\PrivateAssemblies\Microsoft.Web.WebView2.Core.dll')">C:\Program Files\Microsoft Visual Studio\18\Enterprise\Common7\IDE\PrivateAssemblies</VisualStudioWebViewPath>
    <VisualStudioWebViewPath Condition="'$(VisualStudioWebViewPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\PrivateAssemblies\Microsoft.Web.WebView2.Core.dll')">C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\PrivateAssemblies</VisualStudioWebViewPath>
    <VisualStudioWebViewPath Condition="'$(VisualStudioWebViewPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\PrivateAssemblies\Microsoft.Web.WebView2.Core.dll')">C:\Program Files\Microsoft Visual Studio\18\Professional\Common7\IDE\PrivateAssemblies</VisualStudioWebViewPath>
  </PropertyGroup>
</Project>
