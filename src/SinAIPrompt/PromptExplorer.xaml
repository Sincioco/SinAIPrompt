<UserControl x:Class="SinAIPrompt.PromptExplorer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Pane" FontFamily="Segoe UI" FontSize="12">
 <UserControl.Resources>
  <!-- Reserve scrollbar space instead of Fluent's overlay gutters. Clip only the
       viewport so long names and expanded branches remain horizontally scrollable. -->
  <ControlTemplate x:Key="ExplorerScrollTemplate" TargetType="ScrollViewer">
   <Grid Background="{DynamicResource ShellBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" ClipToBounds="True"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Height="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
   </Grid>
  </ControlTemplate>
 </UserControl.Resources>
 <DockPanel>
  <Grid DockPanel.Dock="Top" Height="40" Margin="8,0,4,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Heading" Text="Prompt Explorer" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
   <Button Grid.Column="1" x:Name="ChooseFolder" Content="&#xE8B7;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Padding="4" Click="FolderClick" ToolTip="Choose Working Folder" AutomationProperties.Name="Choose Working Folder"/>
   <Button Grid.Column="2" Content="&#xE710;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Padding="4" Click="NewClick" ToolTip="New Document (Ctrl+N)" AutomationProperties.Name="New Document"/>
   <Button Grid.Column="3" x:Name="ModeButton" Content="&#xE8FD;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Padding="4" Click="ModeClick" ToolTip="Switch To Document List" AutomationProperties.Name="Switch Navigation Mode"/>
  </Grid>
  <StackPanel x:Name="ExplorerTools" DockPanel.Dock="Top" Margin="8,0,6,6">
   <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="RefreshClick" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh Prompt Explorer"><Viewbox Width="16" Height="16"><Path Width="24" Height="24" Data="M20,10 A8,8 0 1 0 20,16 M20,4 L20,10 L14,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button><CheckBox x:Name="Folders" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="FoldersClick"><TextBlock Text="Show Folders" VerticalAlignment="Center"/></CheckBox></DockPanel>
   <TextBlock x:Name="RootLabel" Text="Choose a working folder" ToolTip="{Binding RelativeSource={RelativeSource Self},Path=Text}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
   <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Hidden" Margin="0,5,0,0"/>
   <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>
  <Grid>
   <TreeView x:Name="Tree" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="2" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" SelectedItemChanged="Selected" PreviewKeyDown="TreeKeyDown" AutomationProperties.Name="Prompt Explorer">
    <TreeView.Template><ControlTemplate TargetType="TreeView"><ScrollViewer x:Name="PART_ScrollViewer" Template="{StaticResource ExplorerScrollTemplate}" Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></TreeView.Template>
    <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="Padding" Value="2,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></TreeView.ItemContainerStyle>
   </TreeView>
  </Grid>
 </DockPanel>
</UserControl>
