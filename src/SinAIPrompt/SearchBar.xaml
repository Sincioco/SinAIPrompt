<UserControl x:Class="SinAIPrompt.SearchBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed" MaxWidth="700" HorizontalAlignment="Center" Margin="10,8">
 <Border Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Content="⌃" Style="{StaticResource FlatButton}" Click="ToggleReplace" ToolTip="Show / Hide Replace" AutomationProperties.Name="Show Replace"/>
    <TextBox x:Name="FindBox" Grid.Column="1" MinWidth="220" Width="380" Margin="4,0,8,0" AutomationProperties.Name="Find Text" TextChanged="SearchChanged" PreviewKeyDown="FindKeyDown"/>
    <TextBlock Grid.Column="1" Text="Find" Margin="14,0,8,0" IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=FindBox,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Button Grid.Column="2" Content="↓" Style="{StaticResource FlatButton}" Click="NextClick" ToolTip="Find Next (Enter / F3)" AutomationProperties.Name="Find Next"/>
    <Button Grid.Column="3" Content="↑" Style="{StaticResource FlatButton}" Click="PreviousClick" ToolTip="Find Previous (Shift+Enter / Shift+F3)" AutomationProperties.Name="Find Previous"/>
    <Button Grid.Column="4" Content="&#xE9E9;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Click="OptionsClick" ToolTip="Search Options" AutomationProperties.Name="Search Options"/>
    <Button Grid.Column="5" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Click="CloseClick" ToolTip="Close (Esc)" AutomationProperties.Name="Close Search"/>
   </Grid>
   <WrapPanel x:Name="Options" Visibility="Collapsed" Margin="8,8,0,0">
    <CheckBox x:Name="MatchCase" Content="Match Case" Margin="0,0,16,0" Click="OptionChanged"/>
    <CheckBox x:Name="Regex" Content="Regular Expression" Margin="0,0,16,0" Click="OptionChanged"/>
    <CheckBox x:Name="WholeWord" Content="Whole Word" Margin="0,0,16,0" Click="OptionChanged"/>
    <CheckBox x:Name="Wrap" Content="Wrap Around" IsChecked="True"/>
   </WrapPanel>
   <Grid x:Name="ReplacePanel" Visibility="Collapsed" Margin="8,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="ReplaceBox" AutomationProperties.Name="Replace With"/><Button Grid.Column="1" Content="Replace" Margin="8,0,0,0" Click="ReplaceClick"/><Button Grid.Column="2" Content="Replace All" Margin="8,0,0,0" Click="ReplaceAllClick"/>
   </Grid>
   <TextBlock x:Name="Status" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,4,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Border>
</UserControl>
