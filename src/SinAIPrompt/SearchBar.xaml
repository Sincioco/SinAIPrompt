<UserControl x:Class="SinAIPrompt.SearchBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed" Width="280" MinWidth="220" HorizontalAlignment="Stretch">
 <Border Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="12">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <Grid Margin="0,0,0,12"><TextBlock Text="Find" FontSize="20" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Style="{StaticResource FlatButton}" Click="CloseClick" ToolTip="Close (Esc)" AutomationProperties.Name="Close Search"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="FindBox" MinWidth="120" AutomationProperties.Name="Find Text" TextChanged="SearchChanged" PreviewKeyDown="FindKeyDown"/>
     <Button Grid.Column="1" Content="⌄" Style="{StaticResource FlatButton}" Click="OptionsClick" ToolTip="Search Options" AutomationProperties.Name="Search Options"/>
    </Grid>
    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     <Button Grid.Column="1" Content="↑" Style="{StaticResource FlatButton}" Click="PreviousClick" ToolTip="Find Previous (Shift+Enter / Shift+F3)" AutomationProperties.Name="Find Previous"/>
     <Button Grid.Column="2" Content="↓" Style="{StaticResource FlatButton}" Click="NextClick" ToolTip="Find Next (Enter / F3)" AutomationProperties.Name="Find Next"/>
    </Grid>
    <StackPanel x:Name="Options" Visibility="Collapsed" Margin="0,0,0,8">
     <CheckBox x:Name="MatchCase" Content="Match Case" Click="OptionChanged"/>
     <CheckBox x:Name="Regex" Content="Regular Expression" Click="OptionChanged"/>
     <CheckBox x:Name="WholeWord" Content="Whole Word" Click="OptionChanged"/>
     <CheckBox x:Name="Wrap" Content="Wrap Around" IsChecked="True"/>
     <Button Content="Show / Hide Replace" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ToggleReplace" AutomationProperties.Name="Show Replace"/>
    </StackPanel>
    <StackPanel x:Name="ReplacePanel" Visibility="Collapsed" Margin="0,0,0,8">
     <TextBox x:Name="ReplaceBox" AutomationProperties.Name="Replace With"/>
     <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="Replace" Click="ReplaceClick"/><Button Content="Replace All" Margin="6,0,0,0" Click="ReplaceAllClick"/></StackPanel>
    </StackPanel>
   </StackPanel>
   <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="ResultSelected" AutomationProperties.Name="Find Results">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="6,10"><TextBlock TextWrapping="Wrap"><Run Text="{Binding Before}"/><Run Text="{Binding Match}" Background="#FFFF72" Foreground="#111111"/><Run Text="{Binding After}"/></TextBlock></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
 </Border>
</UserControl>
